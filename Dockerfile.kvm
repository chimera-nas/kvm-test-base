ARG DOCKER_MIRROR
ARG UBUNTU_VERSION=24.04
FROM ${DOCKER_MIRROR}ubuntu:${UBUNTU_VERSION}

ARG KERNEL_PACKAGE=linux-image-generic
ARG UBUNTU_VERSION_CODENAME
ARG APT_MIRROR

ENV DEBIAN_FRONTEND=noninteractive

RUN if [ -n "${APT_MIRROR}" -a -n "${UBUNTU_VERSION_CODENAME}" ]; then \
    echo "deb ${APT_MIRROR} ${UBUNTU_VERSION_CODENAME} main universe" > /etc/apt/sources.list.d/local-mirror.list && \
    echo "deb ${APT_MIRROR} ${UBUNTU_VERSION_CODENAME}-updates main universe" >> /etc/apt/sources.list.d/local-mirror.list && \
    echo "deb ${APT_MIRROR} ${UBUNTU_VERSION_CODENAME}-security main universe" >> /etc/apt/sources.list.d/local-mirror.list && \
    rm -f /etc/apt/sources.list.d/ubuntu.sources; \
    fi

RUN apt-get -y update && \
    apt-get -y --no-install-recommends upgrade && \
    apt-get -y --no-install-recommends install \
    nfs-common cifs-utils iputils-ping netbase \
    ${KERNEL_PACKAGE} initramfs-tools kmod iproute2 \
    build-essential git ca-certificates libnsl-dev \
    time \
    python3 tcpdump sudo \
    autoconf automake libtool pkg-config \
    libaio-dev libacl1-dev liburing-dev \
    uuid-dev xfslibs-dev libattr1-dev \
    libcap-dev libnuma-dev libtirpc-dev libkeyutils-dev keyutils libssl-dev bc && \
    update-initramfs -c -k all && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man

RUN git clone https://github.com/chimera-nas/cthon04.git /opt/cthon04 && \
    cd /opt/cthon04 && \
    CTHON_CFLAGS="CFLAGS=-DLINUX -DHAVE_SOCKLEN_T -DGLIBC=22 -DMMAP -DSTDARG -std=gnu89" && \
    make domount getopt "$CTHON_CFLAGS" && \
    make -C basic "$CTHON_CFLAGS" && \
    make -C general "$CTHON_CFLAGS" && \
    make -C special "$CTHON_CFLAGS" && \
    make -C lock "$CTHON_CFLAGS" && \
    chmod a+x runtests

RUN git clone https://github.com/chimera-nas/xfstests.git /opt/xfstests && \
    cd /opt/xfstests && \
    make configure && \
    ./configure && \
    make

# Pre-generate nametest input file (nametest reads filenames from a file)
RUN seq 1 100 | awk '{printf "xfstest_name_%04d\n", $1}' > /opt/xfstests/nametest_input

# Linux nfstest suite (client-side, mounts the share itself + captures traffic
# with tcpdump).  Pinned to the chimera fork's tag (v3.2 + a one-line open-test
# fix for the modern-kernel O_CREAT|O_DIRECTORY EINVAL behaviour).
RUN git clone https://github.com/chimera-nas/nfstest.git /opt/nfstest && \
    git -C /opt/nfstest checkout v3.2-chimera1

# Linux Test Project (LTP).  Runs against a server-mounted directory (the harness
# pre-mounts the share at /mnt), so unlike nfstest it needs no special wiring --
# the chimera ctest matrix just hands runltp a scenario group + a per-group skip
# file.  Pinned to a stable LTP release tag.  Build into /opt/ltp; drop the source
# tree afterwards (make install copies runltp, runtest/ and testcases/bin into the
# prefix).
RUN git clone https://github.com/linux-test-project/ltp.git /opt/ltp-src && \
    git -C /opt/ltp-src checkout 20260529 && \
    cd /opt/ltp-src && \
    make autotools && \
    ./configure --prefix=/opt/ltp && \
    make -j"$(nproc)" && \
    make install && \
    rm -rf /opt/ltp-src

# kirk: the LTP test runner.  Upstream removed the old runltp (it now just prints
# "use kirk" and exits 1), so the suite is driven by kirk -- a standalone,
# pure-Python (stdlib-only) runner invoked as `python3 /opt/kirk/kirk`, pointed at
# the installed LTP tree via LTPROOT.  ltp-run.sh wraps it; see below.
RUN git clone --depth 1 -b v4.1.0 https://github.com/linux-test-project/kirk.git /opt/kirk

# Per-group LTP skip files (the allowlist): tests that fail/break for reasons
# intrinsic to NFS (no local block device, root-on-local-fs semantics, syscalls
# the protocol cannot express) are listed here so runltp -S skips them, leaving
# any remaining TFAIL/TBROK as a genuine server regression.  Seeded from a memfs
# baseline run; refine as backends are fixed.
COPY ltp-skip/ /opt/ltp-skip/

# Wrapper the chimera ctest matrix invokes as `ltp-run.sh <group>`: runs the
# group via kirk with its skip file and turns the JSON report into a pass/fail
# exit code.
COPY ltp-run.sh /opt/ltp-run.sh
RUN chmod +x /opt/ltp-run.sh

COPY init.sh /init.sh
RUN chmod +x /init.sh

RUN ln -sf $(ls /boot/vmlinuz-* | head -1) /boot/vmlinuz && \
    ln -sf $(ls /boot/initrd.img-* | head -1) /boot/initrd
